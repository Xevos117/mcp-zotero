{
  "name": "@xevos117/mcp-zotero",
  "type": "module",
  "version": "1.0.9",
  "description": "Unofficial MCP server for Zotero integration with citation management",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xevos117/mcp-zotero.git"
  },
  "homepage": "https://github.com/Xevos117/mcp-zotero#readme",
  "bugs": {
    "url": "https://github.com/Xevos117/mcp-zotero/issues"
  },
  "main": "build/server.js",
  "bin": {
    "mcp-zotero": "build/server.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "node build/server.js",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zotero",
    "zotero-api",
    "citation",
    "bibliography",
    "reference-manager",
    "claude",
    "ai"
  ],
  "author": "Xevos17",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.8.0",
    "jszip": "^3.10.1",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3",
    "zotero-api-client": "^0.48.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
