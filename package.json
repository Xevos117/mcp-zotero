{
  "name": "@xevos117/mcp-zotero",
  "type": "module",
  "version": "1.0.9",
  "description": "Unofficial MCP server for Zotero integration with citation management",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xevos117/mcp-zotero.git"
  },
  "homepage": "https://github.com/Xevos117/mcp-zotero#readme",
  "bugs": {
    "url": "https://github.com/Xevos117/mcp-zotero/issues"
  },
  "main": "build/server.js",
  "bin": {
    "mcp-zotero": "build/server.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "smoke": "node scripts/smoke-stdio.mjs",
    "start": "node build/server.js",
    "prepublishOnly": "npm test && npm run build",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zotero",
    "zotero-api",
    "citation",
    "bibliography",
    "reference-manager",
    "claude",
    "ai"
  ],
  "author": "Xevos17",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.6",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5",
    "zotero-api-client": "^0.51.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
